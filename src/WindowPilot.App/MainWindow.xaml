<Window x:Class="WindowPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowPilot"
        Icon="Assets/windowpilot.ico"
        Width="630" Height="700" MinWidth="490" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#0B101B"
        Foreground="#F2F5FC"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="TextMain" Color="#F2F5FC"/>
        <SolidColorBrush x:Key="TextSub" Color="#8E9AB0"/>
        <SolidColorBrush x:Key="Stroke" Color="#293246"/>
        <SolidColorBrush x:Key="Surface" Color="#151C2B"/>
        <SolidColorBrush x:Key="Highlight" Color="#8493FF"/>

        <!-- Consistent dark buttons: visible surfaces, clear borders and hover/pressed states. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E1E9FC"/>
            <Setter Property="Background" Value="#202B42"/>
            <Setter Property="BorderBrush" Value="#394862"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Area" Background="{TemplateBinding Background}"
                                CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Area" Property="Background" Value="#2B3B57"/>
                                <Setter TargetName="Area" Property="BorderBrush" Value="#7386BC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Area" Property="Background" Value="#35486A"/>
                                <Setter TargetName="Area" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.975" ScaleY="0.975"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Area" Property="BorderBrush" Value="#93A0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Area" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="#263454"/>
            <Setter Property="BorderBrush" Value="#506490"/>
            <Setter Property="Foreground" Value="#F1F4FF"/>
            <Setter Property="MinWidth" Value="162"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#161F30"/>
            <Setter Property="BorderBrush" Value="#26334B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Area" Background="{TemplateBinding Background}"
                                CornerRadius="10" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Area" Property="Background" Value="#263650"/>
                                <Setter TargetName="Area" Property="BorderBrush" Value="#46567A"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Area" Property="Background" Value="#2A3A61"/>
                                <Setter TargetName="Area" Property="BorderBrush" Value="#8492FF"/>
                                <Setter Property="Foreground" Value="#F7F8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Area" Property="Background" Value="#3B4A70"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Area" Property="BorderBrush" Value="#A0ADFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#6E7BFF"/>
            <Setter Property="BorderBrush" Value="#94A0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Area" Background="{TemplateBinding Background}" CornerRadius="11"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Area" Property="Background" Value="#8895FF"/>
                                <Setter TargetName="Area" Property="BorderBrush" Value="#B2BAFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Area" Property="Background" Value="#5968E7"/>
                                <Setter TargetName="Area" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Area" Property="Background" Value="#333F5B"/>
                                <Setter TargetName="Area" Property="BorderBrush" Value="#3D4760"/>
                                <Setter Property="Foreground" Value="#939FBA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="#2A1926"/>
            <Setter Property="Foreground" Value="#FFA3B5"/>
            <Setter Property="BorderBrush" Value="#633748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Area" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Area" Property="Background" Value="#563043"/>
                                <Setter TargetName="Area" Property="BorderBrush" Value="#A65B71"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Area" Property="Background" Value="#73384F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Area" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeleteConfirmButton" TargetType="Button" BasedOn="{StaticResource DeleteButton}">
            <Setter Property="Background" Value="#923C56"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <Style x:Key="ModernSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="48" Height="27">
                            <Border x:Name="Track" Background="#46516A" CornerRadius="14"/>
                            <Ellipse x:Name="Thumb" Width="21" Height="21" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#717FFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="23,21,23,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,19">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="43" Height="43" Background="#1C2850" CornerRadius="12" Padding="9">
                    <Image Source="Assets/windowpilot.ico" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="WindowPilot" FontSize="21" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMain}" Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Width="39" Height="39"
                    Style="{StaticResource IconButton}"
                    ToolTip="Refresh window list" Click="RefreshButton_Click">
                <Viewbox Width="18" Height="18" Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="#DCE6FF" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M19.2,8.8 A7.8,7.8 0 1 0 20.9,13.9 M19.2,8.8 V4.7 M19.2,8.8 H15.1"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>

        <!-- Zwei einfache Tabs statt separatem Einstellungsfenster. -->
        <Grid Grid.Row="1" Margin="0,0,0,17">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="GeneralTabButton" Grid.Column="0" Height="39"
                    Style="{StaticResource TabButton}" Click="GeneralTabButton_Click"
                    FontWeight="SemiBold" Content="General"/>
            <Button x:Name="SettingsTabButton" Grid.Column="2" Height="39"
                    Style="{StaticResource TabButton}" Click="SettingsTabButton_Click"
                    FontWeight="SemiBold" Content="Settings"/>
        </Grid>

        <Grid x:Name="GeneralPanel" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="1,0,1,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="SELECT WINDOWS" FontSize="11" FontWeight="SemiBold"
                           Foreground="#AAB8D1" VerticalAlignment="Center"/>
                <TextBlock x:Name="MarkedCountText" Grid.Column="1" FontSize="12"
                           Foreground="{StaticResource TextSub}" Text="0 selected"/>
            </Grid>
        <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                Background="#101727" CornerRadius="15" Padding="9">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="WindowList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="WindowRow" Background="#172031"
                                    BorderBrush="#283247" BorderThickness="1"
                                    CornerRadius="11" Margin="0,0,0,7" Padding="12"
                                    Cursor="Hand" MouseLeftButtonUp="WindowRow_MouseLeftButtonUp"
                                    ToolTip="Click to select or deselect this window">
                                <Grid Height="43">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="41"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="37" Height="37" CornerRadius="9"
                                            Background="#253046" VerticalAlignment="Center">
                                        <Image Source="{Binding AppIcon}" Width="27" Height="27"
                                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Window.ProcessName}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#F0F4FD"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border x:Name="SavedIndicator" Grid.Column="1" Visibility="Collapsed"
                                                    Background="#243858" CornerRadius="5" Padding="6,3"
                                                    Margin="7,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="IN LAYOUT" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="#A8BEFF"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Window.Title}" FontSize="11.5"
                                                   Margin="0,4,0,0" Foreground="#90A0BA"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border x:Name="SelectionCircle" Grid.Column="2" Width="21" Height="21"
                                            CornerRadius="11" Background="Transparent" BorderBrush="#526078"
                                            BorderThickness="1.5" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedCheck" Text="✓" FontWeight="Bold" FontSize="13"
                                                   Foreground="White" Visibility="Collapsed"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="WindowRow" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="WindowRow" Property="Background" Value="#212D43"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                    <Setter TargetName="SavedIndicator" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                    <Setter TargetName="WindowRow" Property="Background" Value="#212E50"/>
                                    <Setter TargetName="WindowRow" Property="BorderBrush" Value="#8191FF"/>
                                    <Setter TargetName="SelectionCircle" Property="Background" Value="#717FFF"/>
                                    <Setter TargetName="SelectionCircle" Property="BorderBrush" Value="#717FFF"/>
                                    <Setter TargetName="SelectedCheck" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>


            <Grid Grid.Row="2" Height="48" Margin="0,14,0,0">
                <Grid x:Name="SaveActions">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="47"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SaveLayoutButton" Grid.Column="0" Height="48"
                            Style="{StaticResource PrimaryButton}" Click="SaveLayoutButton_Click"
                            ToolTip="Save selected windows and their current positions">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Width="17" Height="17" Stroke="White" StrokeThickness="1.65"
                                  StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0"
                                  Data="M 4,3 L 17,3 L 21,7 L 21,21 L 3,21 L 3,3 Z M 7,3 L 7,10 L 17,10 L 17,3 M 7,21 L 7,14 L 17,14 L 17,21"/>
                            <TextBlock x:Name="SaveLayoutButtonText" Text="Save Layout"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RestoreLayoutButton" Grid.Column="2" Height="48"
                            Style="{StaticResource SettingsActionButton}" Click="RestoreLayoutButton_Click"
                            ToolTip="Move open windows back to their saved positions">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Width="18" Height="18" Stroke="#CDD8FF" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0"
                                  Data="M 3,3 L 21,3 L 21,20 L 3,20 Z M 12,6 L 12,16 M 8,12 L 12,16 L 16,12"/>
                            <TextBlock Text="Apply Layout" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteLayoutButton" Grid.Column="4" Height="48"
                            Style="{StaticResource DeleteButton}" Click="DeleteLayoutButton_Click"
                            ToolTip="Delete saved layouts and WindowPilot data (does not affect Auto Start)">
                        <Path Stroke="#FFA3B5" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="21" Height="21" Stretch="Uniform"
                              Data="M 4,6 L 20,6 M 7,6 L 8,21 L 16,21 L 17,6 M 9,6 L 9,3 L 15,3 L 15,6 M 10,9 L 10,17 M 14,9 L 14,17"/>
                    </Button>
                </Grid>
                <Border x:Name="DeleteConfirmation" Visibility="Collapsed" Background="#281C2A"
                        BorderBrush="#714153" BorderThickness="1" CornerRadius="11" Padding="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Delete layout &amp; data?" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#FFCCDA"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="5,0,7,0"/>
                        <Button Grid.Column="1" Content="Delete" Click="ConfirmDeleteButton_Click"
                                Style="{StaticResource DeleteConfirmButton}" Margin="0,0,6,0"/>
                        <Button Grid.Column="2" Content="Cancel" Click="CancelDeleteButton_Click"
                                Style="{StaticResource IconButton}" Padding="10,6"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold"
                           Foreground="#AAB8D1" Margin="1,0,0,12"/>
                <Border Background="#151E2F" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1" CornerRadius="13" Padding="16,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Window Assignment" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Assign similar windows to any available saved slot"
                                       TextWrapping="Wrap" FontSize="11" Foreground="#8E9AB0" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ModeStateText" Text="Free Slots" FontSize="11"
                                       VerticalAlignment="Center" Foreground="#C7D1E4" Margin="0,0,9,0"/>
                            <ToggleButton x:Name="AssignmentModeSwitch" Style="{StaticResource ModernSwitch}"
                                          ToolTip="Free Slots / Individual"
                                          Checked="AssignmentModeSwitch_Changed" Unchecked="AssignmentModeSwitch_Changed"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="#151E2F" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1" CornerRadius="13" Padding="16,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Auto Start" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Launch in the background when signing in to Windows" FontSize="11"
                                       Foreground="#8E9AB0" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="StartupStateText" Text="Off" FontSize="11" Foreground="#C7D1E4"
                                       VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <ToggleButton x:Name="AutostartSwitch" Style="{StaticResource ModernSwitch}"
                                          Checked="AutostartSwitch_Changed" Unchecked="AutostartSwitch_Changed"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="#151E2F" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1" CornerRadius="13" Padding="16,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Updates" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Checks once at launch; manual check anytime" FontSize="11"
                                       Foreground="#8E9AB0" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="CheckUpdatesButton" Grid.Column="1" VerticalAlignment="Center"
                                Style="{StaticResource SettingsActionButton}" Click="CheckUpdatesButton_Click"
                                ToolTip="Check GitHub Releases for a newer version">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Width="17" Height="17" Stroke="#C5D3FF" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform" VerticalAlignment="Center"
                                      Margin="0,0,9,0"
                                      Data="M 12,3 L 12,15 M 7,10 L 12,15 L 17,10 M 4,17 L 4,21 L 20,21 L 20,17"/>
                                <TextBlock x:Name="CheckUpdatesButtonLabel" Text="Check for Updates"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <Border Background="#151E2F" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1" CornerRadius="13" Padding="16,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Application Location" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Show the WindowPilot executable in File Explorer"
                                       FontSize="11" Foreground="#8E9AB0" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="OpenInstallFolderButton" Grid.Column="1" VerticalAlignment="Center"
                                Style="{StaticResource SettingsActionButton}"
                                Click="OpenInstallFolderButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Fill="#CDD8FF" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                      Data="M 2,5 L 9,5 L 11,8 L 22,8 L 22,20 L 2,20 Z M 2,5 L 2,3 L 9,3 L 11,5"/>
                                <TextBlock Text="Show EXE" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="11" Foreground="#7F8BA3">
                <Run Text="Developed by "/><Run Text="diabolidev" FontWeight="SemiBold" Foreground="#ABB6FF"/>
            </TextBlock>
            <TextBlock x:Name="VersionText" Grid.Column="2" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="#65728B" FontSize="10" Text="v0.1.0"/>
        </Grid>
    </Grid>
</Window>
